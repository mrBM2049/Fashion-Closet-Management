# ─────────────────────────────────────────────────────────────
# ThreadShare — Environment Variables
# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# IMPORTANT NOTES:
#   - Use 127.0.0.1 instead of localhost on Windows
#     (localhost resolves via IPv6 which MySQL doesn't listen on)
#   - Do NOT wrap values in quotes — write the value directly
#   - If your password contains # or special chars, no quotes needed
#     e.g.  DB_PASSWORD=MyPass#2024   (correct)
#           DB_PASSWORD="MyPass#2024" (wrong — quotes become part of the value)
# ─────────────────────────────────────────────────────────────

# Database (MySQL 8.0)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=threadshare

# Auth.js v5 — generate a random 32+ char string for AUTH_SECRET
# You can run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-a-random-32-char-secret
AUTH_URL=http://localhost:3000
